-- -- local script_mode = "PVP" -- โหมด PVP, FARM
local script_mode = "PVP" -- คุณสามารถเปลี่ยนเป็น "FARM" ได้หากเกมรองรับ

scripts = {
    [6765805766] = { -- Blox Spin
        PVP = "https://api.luarmor.net/files/v3/loaders/f35c34bae1acf8c1422df5214310b8eb.lua",
        FARM = "https://api.luarmor.net/files/v3/loaders/32b520fd3ef340a3c6f701b6edf48e55.lua",
    },
    [994732206] = { -- Blox Fruits
        PVP = "https://api.luarmor.net/files/v3/loaders/341aeb3eaa42e6423a4cdbf2b148e77f.lua",
        -- FARM = "", -- เพิ่มลิงก์สคริปต์ฟาร์มสำหรับ Blox Fruits ที่นี่ (ถ้ามี)
    }
}

-- สร้างชื่อโปรไฟล์จากชื่อผู้ใช้ Roblox ของคุณ
local player = game:GetService("Players").LocalPlayer
local profile_name = player.Name

local cfg = scripts[game.GameId]
if not cfg then
    player:Kick("Game not supported (Unsupported by " .. profile_name .. "'s script)")
    return
end

-- พิมพ์ชื่อโปรไฟล์เพื่อยืนยัน (ไม่บังคับ)
print("Loading script for user: " .. profile_name)

loadstring(game:HttpGet(cfg[(script_mode or "PVP"):upper()] or cfg.PVP))()
